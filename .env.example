# Phase 2-5: copy to .env.local and set the public project configuration.
# Save .env.local, restart the dev server, then run npm.cmd run db:check.
# Public browser configuration only. Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# supabase (default): read DB; on failure show an explicit local-recovery notice.
# local: intentionally use the original JSON for development/recovery.
RESTAURANT_DATA_SOURCE=supabase
NEXT_PUBLIC_NAVER_MAPS_KEY_ID=
# Maps: public Key ID only; enable Web Dynamic Map and restrict Web service URLs.
# Never use a NAVER Client Secret here. See docs/maps-setup.md.

# Email Auth: set Site URL, Confirm email and template in Supabase Dashboard.
# See docs/auth-setup.md. OAuth was cancelled; no OAuth secrets are needed.
# No service-role/secret key is used by the app.
